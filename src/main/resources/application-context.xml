<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->


	<bean name="add1" class="spring.model.Address">
		<property name="city" value="Pune" />
		<property name="state" value="Maharashtra" />
	</bean>


	<bean name="emp1" class="spring.model.Employee">

		<property name="id" value="1011" />
		<property name="name" value="Vikas" />
		<property name="gender" value="Male" />
		<property name="address" ref="add1" />
<!--		list by property-->
		<property name="list">
			<list>
				<value>3464</value>
				<value>null</value>
				<value>abc</value>
				<value>632</value>
				<value>3464</value>
				<value>000</value>
			</list>
		</property>
<!--		set by property-->
		<property name="set">
			<set>
				<value>3464</value>
				<value>null</value>
				<value>abc</value>
				<value>632</value>
				<value>3464</value>
				<value>000</value>
			</set>
		</property>
<!--		map by property-->
		<property name="map">
			<map>
				<entry key="1" value="One"></entry>
				<entry key="2" value="Two"></entry>
				<entry key="3" value="Three"></entry>
				<entry key="4" value="Four"></entry>
				<entry key="5" value="Five"></entry>
			</map>
		</property>


	</bean>


	<bean name="add2" class="spring.model.Address">
		<constructor-arg name="city" value="Noida" />
		<constructor-arg name="state" value="UP" />
	</bean>



	<bean name="emp2" class="spring.model.Employee">
		<constructor-arg name="id" value="222" />
		<constructor-arg name="name" value="Anurag" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="address" ref="add2" />
<!--		list by constructor-->
		<constructor-arg name="list">
			<list>
				<value>4050</value>
				<value>null</value>
				<value>678</value>
				<value>xyz</value>
				<value>2345</value>
				<value>2345</value>
			</list>
		</constructor-arg>
<!--		set by constructor-->
		<constructor-arg name="set">
			<set>
				<value>4050</value>
				<value>null</value>
				<value>678</value>
				<value>xyz</value>
				<value>2345</value>
				<value>2345</value>
			</set>
		</constructor-arg>
<!--		map by constructor-->
		<constructor-arg name="map">
			<map>
				<entry key="1" value="One"></entry>
				<entry key="2" value="Two"></entry>
				<entry key="3" value="Three"></entry>
				<entry key="4" value="Four"></entry>
				<entry key="5" value="Five"></entry>
			</map>
		</constructor-arg>
		
	</bean>
	


</beans>